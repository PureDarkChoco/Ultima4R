# Godot 4+ specific ignores
.godot/
/android/
/build/
/dist/

# macOS / editor junk
.DS_Store
**/.DS_Store
Library/

# Local scratch / dumps (never commit)
.tmp_*/
MEMDUMP.*
tools/__pycache__/
tools/ko_tlk_extract/
tools/_tmp_*
tools/_present_zone.png*
tools/_title_*.png*
tools/_top_band.png*
assets/portraits/companions copy/

# Ultima IV original data (symlink or copy — never commit)
/data/u4
/data/**
!/data/.gdignore


# Ultima VI GOG extracts (regenerate via tools/extract_u6_tiles.py)
assets/tiles/u6/
assets/ui/u6/

# Apple II U4 tile dumps (copyrighted original art — local reference only)
reference/apple2_u4/
assets/tiles/apple2_color/shapes.u4hgr
assets/tiles/apple2_color/shapes.u4pack
assets/tiles/apple2_color/shapes/
assets/tiles/apple2_mono/shapes.u4pack
assets/tiles/apple2_mono/shapes/

# Local Python tooling (Pillow etc.)
.tools_py/

# Native GDExtension intermediate trees (platform binaries under bin/ are shipped)
/native/libhangul_gdext/build-*/
