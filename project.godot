; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ultima IV++"
config/description="Modernized Ultima IV remake (Godot)"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

SingleInstance="*res://src/core/single_instance.gd"
GameState="*res://src/core/game_state.gd"
Locale="*res://src/core/locale.gd"
SceneRouter="*res://src/core/scene_router.gd"
DisplaySettings="*res://src/core/display_settings.gd"
QuitConfirm="*res://src/core/quit_confirm.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=2
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/theme/u4r_theme.tres"

